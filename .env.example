# Copy to .env (gitignored) for `npm run auth:inspect`. MCP clients pass these via their own config (see docs/GUIDE.md).
# On macOS nothing is needed here: the token is read from the Keychain item that
# `bevel-mcp token capture` / `token set` save. To override, choose ONE (first non-empty wins):
# BEVEL_TOKEN=eyJ...                       # least safe: token sits in plain text
# BEVEL_TOKEN_FILE=/Users/you/.config/bevel-mcp/token
# BEVEL_TOKEN_COMMAND="/usr/bin/security find-generic-password -s bevel-mcp -a token -w"

BEVEL_BASE_URL=https://api.supersethealth.com
BEVEL_APP_VERSION=3.2.7
# BEVEL_USER_AGENT=bevel-mcp/0.1
BEVEL_TIMEZONE=America/New_York

# Write tools refuse to run unless this is "true".
BEVEL_ENABLE_WRITES=false

# error | warn | info | debug  (logs go to stderr; secrets are redacted)
BEVEL_LOG_LEVEL=info
